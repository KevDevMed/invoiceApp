# Keep the build context small and make sure nothing host-specific — a local
# node_modules with a native addon built for the wrong ABI, a real database —
# leaks into the image.

.git
.gitignore
node_modules
**/node_modules

# Build output. preview/dist is produced inside the builder stage.
out
dist
release
preview/dist
coverage
*.tsbuildinfo
.vite

# Preview and app data
preview-data
preview/.artifacts
*.db
*.db-shm
*.db-wal

# Model weights
models

# Not needed to serve the preview
.github
electron-builder.yml
electron.vite.config.ts
AGENTS.md
*.log
.DS_Store
.env
.env.*
