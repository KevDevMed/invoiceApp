{
  "name": "invoiceapp",
  "version": "0.1.2",
  "description": "Offline-first invoicing desktop app (Electron + React + SQLite)",
  "main": "./out/main/index.cjs",
  "author": "InvoiceApp",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview:build": "tsc --noEmit -p preview/tsconfig.json && vite build --config preview/vite.config.ts",
    "preview:serve": "node --import tsx --import ./preview/register-raw.mjs preview/server.ts",
    "preview:dev": "npm run preview:build && npm run preview:serve",
    "preview:test": "vitest run --config preview/vitest.config.ts",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "postinstall": "npm rebuild better-sqlite3 && node -e \"const f=require('node:fs');f.mkdirSync('node_modules/better-sqlite3/build/node-abi',{recursive:true});f.copyFileSync('node_modules/better-sqlite3/build/Release/better_sqlite3.node','node_modules/better-sqlite3/build/node-abi/better_sqlite3.node')\" && electron-rebuild -f -w better-sqlite3 -m ."
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@astryxdesign/theme-neutral": "0.1.8",
    "better-sqlite3": "^12.4.1",
    "node-llama-cpp": "^3.19.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.8",
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.38.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.5.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@astryxdesign/cli@0.1.8": true,
    "@astryxdesign/core@0.1.8": true,
    "better-sqlite3@12.4.1": true,
    "electron@38.4.0": true,
    "esbuild@0.25.12": true
  }
}
